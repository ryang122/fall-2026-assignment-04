erDiagram
    USERS ||--o| BORROWERS : "has profile"
    GENRES ||--o{ BOOKS : "categorizes"
    BOOKS ||--o{ BOOK_AUTHORS : "has author"
    AUTHORS ||--o{ BOOK_AUTHORS : "writes"
    BORROWERS ||--o{ LOANS : "places"
    BOOKS ||--o{ LOANS : "borrowed in"

    USERS {
        int id PK
        string email UK
        string name
        timestamp created_at
    }
    BORROWERS {
        int id PK
        int user_id FK, UK
        string membership_number UK
        string phone
    }
    GENRES {
        int id PK
        string name UK
        text description
    }
    AUTHORS {
        int id PK
        string name
        text bio
    }
    BOOKS {
        int id PK
        int genre_id FK
        string title
        string isbn UK
        int total_copies
        int available_copies
    }
    BOOK_AUTHORS {
        int id PK
        int book_id FK
        int author_id FK
    }
    LOANS {
        int id PK
        int borrower_id FK
        int book_id FK
        date loan_date
        date due_date
        date return_date
        string status
    }
